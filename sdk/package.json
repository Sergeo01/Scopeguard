{
  "name": "@scopeguard/sdk",
  "version": "0.4.0",
  "description": "TypeScript SDK for ScopeGuard scoped NEAR agent passkeys",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "scopeguard": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npx tsx --test test/*.test.ts"
  },
  "dependencies": {
    "near-api-js": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0"
  }
}
