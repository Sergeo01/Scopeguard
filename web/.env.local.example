# ScopeGuard Web Studio Local Environment Configuration
# Copy this file to web/.env.local for local Next.js development

NEAR_NETWORK=testnet
NEAR_TESTNET_RPC=https://rpc.testnet.near.org

# Core Testnet Contract Accounts
NEXT_PUBLIC_POLICY_CONTRACT_ID=guard2.sergeo-guard.testnet
NEXT_PUBLIC_AGENT_ACCOUNT_ID=trader.sergeo-guard.testnet
NEXT_PUBLIC_TOKEN_CONTRACT_ID=sergeo-guard-token.testnet
NEXT_PUBLIC_DEX_CONTRACT_ID=sergeo-guard-dex.testnet
NEXT_PUBLIC_OWNER_ACCOUNT_ID=sergeo-guard.testnet

# Server-Side Environment Variables
POLICY_CONTRACT_ID=guard2.sergeo-guard.testnet
AGENT_ACCOUNT_ID=trader.sergeo-guard.testnet
TOKEN_CONTRACT_ID=sergeo-guard-token.testnet
DEX_CONTRACT_ID=sergeo-guard-dex.testnet
OWNER_ACCOUNT_ID=sergeo-guard.testnet

# Scoped Passkey for Naive Demo Agent on /api/attack
AGENT_PRIVATE_KEY=ed25519:YOUR_AGENT_RESTRICTED_PASSKEY

# Optional: AI Scope Drafter API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
