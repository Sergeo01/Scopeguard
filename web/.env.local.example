# ScopeGuard Web Studio Local Environment Configuration
# Copy this file to web/.env.local for local Next.js development

NEAR_NETWORK=testnet
# Read-capable RPC. fastnear serves transaction history as well as view calls;
# the public near.org endpoint is ~10x slower for a multi-agent read burst and
# returns deprecation warnings on tx lookups. Point this at
# https://rpc.testnet.near.org if you prefer the canonical endpoint.
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com

# Core Testnet Contract Accounts
NEXT_PUBLIC_POLICY_CONTRACT_ID=YOUR_POLICY_CONTRACT.testnet
NEXT_PUBLIC_AGENT_ACCOUNT_ID=agent.sergeo-guard.testnet
NEXT_PUBLIC_TOKEN_CONTRACT_ID=sergeo-guard-token.testnet
NEXT_PUBLIC_DEX_CONTRACT_ID=sergeo-guard-dex.testnet
NEXT_PUBLIC_OWNER_ACCOUNT_ID=sergeo-guard.testnet

# Server-Side Environment Variables
SCOPEGUARD_POLICY_CONTRACT=YOUR_POLICY_CONTRACT.testnet
SCOPEGUARD_AGENT_ACCOUNT=agent.sergeo-guard.testnet
SCOPEGUARD_TOKEN_CONTRACT=sergeo-guard-token.testnet
SCOPEGUARD_DEX_CONTRACT=sergeo-guard-dex.testnet
OWNER_ACCOUNT_ID=sergeo-guard.testnet

# Scoped passkey used by /api/attack. A FunctionCall key restricted to
# YOUR_POLICY_CONTRACT.testnet::execute, not an owner key.
SCOPEGUARD_AGENT_PRIVATE_KEY=ed25519:YOUR_AGENT_RESTRICTED_PASSKEY

# Hosted-demo owner signing is OFF unless you set this to true.
# /api/register and /api/fund will otherwise return a `near call` command.
SCOPEGUARD_ALLOW_SERVER_SIGNING=false
# OWNER_PRIVATE_KEY=ed25519:...

# Optional: AI Scope Drafter API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
