# ScopeGuard Environment Configuration
# Copy this file to .env for local operation

NEAR_NETWORK=testnet
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com

# Core Testnet Deployments
SCOPEGUARD_POLICY_CONTRACT=guard2.sergeo-guard.testnet
SCOPEGUARD_AGENT_ACCOUNT=trader.sergeo-guard.testnet
SCOPEGUARD_TOKEN_CONTRACT=sergeo-guard-token.testnet
SCOPEGUARD_DEX_CONTRACT=sergeo-guard-dex.testnet

# Scoped Passkey (Function-Call Key only, restricted to Guard.execute)
SCOPEGUARD_AGENT_PRIVATE_KEY=ed25519:YOUR_AGENT_RESTRICTED_PASSKEY

# Owner Account ID (Public reference only - never store owner private keys on web servers)
OWNER_ACCOUNT_ID=sergeo-guard.testnet
# NOTE: ScopeGuard is strictly non-custodial. Owner emergency controls (pause, unpause, withdraw, revoke)
# are signed directly via NEAR Wallet Selector or local NEAR CLI, never stored in web environments.
