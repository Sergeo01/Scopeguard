# ScopeGuard Environment Configuration
# Copy this file to .env for local operation

NEAR_NETWORK=testnet
# fastnear serves view calls and tx history; near.org is ~10x slower for a
# multi-agent read burst and deprecates tx lookups.
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com

# Core Testnet Deployments
SCOPEGUARD_POLICY_CONTRACT=YOUR_POLICY_CONTRACT.testnet
SCOPEGUARD_AGENT_ACCOUNT=agent.sergeo-guard.testnet
SCOPEGUARD_TOKEN_CONTRACT=sergeo-guard-token.testnet
SCOPEGUARD_DEX_CONTRACT=sergeo-guard-dex.testnet

# Scoped Passkey (Function-Call Key only, restricted to Guard.execute)
SCOPEGUARD_AGENT_PRIVATE_KEY=ed25519:YOUR_AGENT_RESTRICTED_PASSKEY

# Owner Account ID (public reference only)
OWNER_ACCOUNT_ID=sergeo-guard.testnet

# Optional: hosted-demo owner signing. OFF by default.
# When false, /api/register and /api/fund return a copy-paste `near call`
# command and broadcast nothing. Only enable on a throwaway testnet demo.
SCOPEGUARD_ALLOW_SERVER_SIGNING=false
# OWNER_PRIVATE_KEY=ed25519:...   # env only; the server never reads ~/.near-credentials

# Optional: AI Scope Drafter API Keys (fallback defaults apply if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Real-time Intrusion Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# NOTE: Owner emergency controls (pause, unpause, withdraw, revoke, reset_windows)
# are signed directly via NEAR CLI or a wallet, not by the web server. The one
# exception is the opt-in demo flag above, which exists so the hosted console can
# register a policy without a terminal.
